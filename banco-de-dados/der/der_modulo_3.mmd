erDiagram
    glossario_termos {
        int id PK
        string grupo
        string termo
        text definicao
    }
    glossario_palavras {
        int id PK
        int termo_id FK
        string palavra
    }
    mensagens_chat {
        int id PK
        int usuario_id FK
        int fabrica_id FK
        string autor
        text texto
        datetime criada_em
    }
    fabricas {
        int id PK
        int usuario_id FK
        string nome
        string exemplo_origem
        int temperatura_ambiente
        decimal tarifa_energia
        boolean parada_emergencia
        datetime criada_em
        datetime atualizada_em
    }
    usuarios {
        int id PK
        string nome_usuario
        string nome_exibicao
        string senha_hash
        boolean ativo
        datetime criado_em
        datetime ultimo_acesso_em
    }
    glossario_termos ||--o{ glossario_palavras : "é chamado por"
    fabricas |o--o{ mensagens_chat : "trata de"
    usuarios ||--o{ mensagens_chat : "escreve"
    usuarios ||--o{ fabricas : "possui"
